# Newsxis (Vercel project `newsxis`, Root Directory `web`). Never commit live secrets.

NEXT_PUBLIC_SITE_URL=https://newsxis.vercel.app

# --- Auth + database: the dedicated Supabase project `newsxis` (never a sister site's project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Apixis family (from the Wallet lead; see docs/APIXIS_FAMILY.md) ---
WALLET_API_KEY=
APIXIS_CLIENT_ID=newsxis
APIXIS_WALLET_API_URL=https://apixis-wallet.vercel.app
APIXIS_WORLD_KEY=
APIXIS_WORLD_API=https://www.apixis.dev

# --- Cixy's brain (Anthropic only) ---
ANTHROPIC_API_KEY=
# Cheap model for classification / moderation; strong model for research + briefings.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SMART_MODEL=claude-sonnet-5-5

# --- Cixy's voice (ElevenLabs). Empty = briefings are text-only, no audio is faked. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Map tiles (free tier: https://cloud.maptiler.com). Empty = open OSM raster tiles, no satellite. ---
NEXT_PUBLIC_MAPTILER_KEY=

# --- Cron + worker auth ---
CRON_SECRET=
# Shared with workers/ (radio listener posts transcripts to /api/worker/transcripts)
WORKER_KEY=

# --- Social (see docs/SOCIAL_CHECKLIST.md). Per-account tokens are stored encrypted in social_accounts. ---
TOKEN_ENC_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# --- Owner (admin) ---
OWNER_EMAILS=awad@apixis.dev,alaidaroosawad@gmail.com
SUPPORT_EMAIL=newsxis@apixis.dev
RESEND_API_KEY=
