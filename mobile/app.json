{
  "expo": {
    "name": "Newsxis",
    "slug": "newsxis",
    "scheme": "newsxis",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../web/public/brand/mark.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070f",
    "splash": { "backgroundColor": "#05070f", "resizeMode": "contain", "image": "../web/public/brand/mark.png" },
    "ios": { "bundleIdentifier": "dev.apixis.newsxis", "supportsTablet": true, "infoPlist": { "UIBackgroundModes": ["audio"] } },
    "android": { "package": "dev.apixis.newsxis", "adaptiveIcon": { "foregroundImage": "../web/public/brand/mark.png", "backgroundColor": "#05070f" }, "permissions": ["POST_NOTIFICATIONS"] },
    "plugins": ["expo-router", ["expo-notifications", { "color": "#38e8ff" }]],
    "extra": { "siteUrl": "https://newsxis.apixis.dev", "eas": { "projectId": "" } }
  }
}
